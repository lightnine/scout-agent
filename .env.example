# ===========================================================================
# LLM：任何 OpenAI 兼容端点都可以（智谱 GLM / DeepSeek / Kimi / 本地 vLLM…）
# ===========================================================================
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.2

# 智谱 GLM 支持隐式上下文缓存（无需额外参数）。
# Step 2+ 可在响应 usage.prompt_tokens_details.cached_tokens 查看命中数。
# Scout 已将 static system + 稳定 tools schema 作为可缓存前缀；trace 里 llm_end 事件含 cached_tokens。

# 子 Agent 用的小模型（可选）。调研任务里子 Agent 调用量最大，
# 换成便宜的小模型能显著降本，留空则与主模型一致。
LLM_FAST_MODEL=

# Embedding 模型：用于长期记忆和证据库的语义检索。
# 留空则自动退化为关键词检索，功能不受影响。
LLM_EMBEDDING_MODEL=embedding-3

# DeepSeek 示例
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_EMBEDDING_MODEL=

# 本地 vLLM / Ollama 示例
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=qwen3-8b
# LLM_API_KEY=EMPTY

# ===========================================================================
# 搜索引擎
# ===========================================================================
# 可选值：
#   tavily      专为 LLM 设计，摘要质量最好，需要 Key（推荐）
#   serper      Google 搜索结果，中文长尾覆盖更全，需要 Key
#   duckduckgo  解析网页版搜索页，零 Key 开箱即用，但会被限流
SEARCH_PROVIDER=tavily

# Tavily：https://app.tavily.com 注册即可，有免费额度
TAVILY_API_KEY=
# Serper：https://serper.dev
SERPER_API_KEY=

# 注意：选了 tavily/serper 却没填 Key 时会自动退回 DuckDuckGo，
# 并在搜索结果和启动时给出明确提示，不会静默降级。

# ===========================================================================
# Agent 行为
# ===========================================================================
# 主 Agent 单轮任务最多 loop 多少步
AGENT_MAX_STEPS=30
# 子 Agent 的步数上限
AGENT_SUBAGENT_MAX_STEPS=12
# 最多同时跑几个子 Agent
AGENT_MAX_SUBAGENTS=3
# 工作记忆超过该 token 数触发自动压缩
AGENT_COMPACT_THRESHOLD=16000
# 权限模式：ask（有副作用的操作需确认）/ auto（全自动）/ readonly（禁止落盘）
AGENT_PERMISSION_MODE=ask
# 数据目录：会话库、trace 日志
AGENT_HOME=.scout
